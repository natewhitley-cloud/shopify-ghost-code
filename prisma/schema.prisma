// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Shopify session storage — keep exactly as-is; used by
// @shopify/shopify-app-session-storage-prisma
// ---------------------------------------------------------------------------
model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?

  @@index([shop])
}

// ---------------------------------------------------------------------------
// Ghost Code domain models
// ---------------------------------------------------------------------------

model Shop {
  id                  String           @id @default(cuid())
  domain              String           @unique
  installedAt         DateTime         @default(now())
  plan                String           @default("free")
  // Last time `plan` was reconciled against Shopify's actual active
  // subscriptions (or refreshed by an APP_SUBSCRIPTIONS_UPDATE webhook). Null
  // means never reconciled. Drives the app-load freshness guard so the
  // reconciliation GraphQL query runs at most once per freshness window.
  planReconciledAt    DateTime?
  // Marks an uninstalled-but-not-yet-redacted shop. Null = active install; set =
  // the merchant uninstalled (app/uninstalled fired) and the row is pending the
  // shop/redact hard-delete within the 48h GDPR grace window; cleared back to null
  // on reinstall (see upsertShop). Iterators/metrics exclude non-null rows so a
  // dead shop is never scanned or counted as an active install (gc-grd).
  uninstalledAt       DateTime?
  // Last time a merchant loaded any authenticated app page (freshness-gated
  // write). Null = never seen since this column shipped. Durable "last login";
  // survives beyond the page_visit event retention window. Cleared/kept across
  // reconciles; removed on shop delete (GDPR cascade).
  lastSeenAt          DateTime?
  lastThemePublishAt  DateTime?
  hasSeenReviewPrompt Boolean          @default(false)
  // Durable "internal/dev/test store — excluded from all business metrics" flag;
  // the PRIMARY exclusion signal (the env exclude list + `app-review-` prefix
  // remain as an operational override + ephemeral-review-store coverage). Set
  // once per known internal store so a rename never re-leaks it into metrics.
  isInternal          Boolean          @default(false)
  scans               Scan[]
  billingEvents       BillingEvent[]
  ignoredFindings     IgnoredFinding[]
}

model BillingEvent {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  eventType String // "upgrade" | "downgrade" | "cancellation" | "reactivation"
  fromPlan  String? // null for first subscription
  toPlan    String? // null for cancellation
  amount    Float? // monthly price of toPlan, null for cancellation
  createdAt DateTime @default(now())

  @@index([shopId])
  @@index([createdAt])
  @@index([eventType])
}

model Scan {
  id                String          @id @default(cuid())
  shopId            String
  shop              Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  themeId           String
  themeName         String
  status            ScanStatus      @default(PENDING)
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime        @default(now())
  findingCount      Int             @default(0)
  // FindingType categories whose OPTIONAL audit was skipped this run because the
  // required Shopify scope was not granted (ACCESS_DENIED). Drives PARTIAL status
  // and prevents the diff engine from falsely marking un-audited categories as
  // "resolved" (LOG-4). Empty for fully-audited scans and all legacy scans.
  // Scope-only (gc-11f): a size cap never lands here, see cappedCategories.
  skippedCategories String[]        @default([])
  // FindingType categories whose OPTIONAL audit ran (scope granted) but hit a
  // size cap this run, so only part of the category was checked (gc-11f). The
  // differ excludes skipped + capped from "resolved"; the scan-detail UI shows
  // an info notice (not the permissions warning). Does NOT change status.
  // Empty for uncapped scans and all legacy scans.
  cappedCategories  String[]        @default([])
  // Theme file paths whose per-file detectors were SKIPPED this run because the
  // file exceeded MAX_SCANNABLE_FILE_BYTES (gc-06e.19). Those files were not
  // scanned, so the diff engine must exclude their prior findings from
  // "resolved" — an unscanned file is unknown, not fixed. Also surfaced in the
  // scan-detail UI. Empty for fully-scanned scans and all legacy scans.
  skippedFiles      String[]        @default([])
  // Which surface initiated this scan. Only MANUAL (merchant-initiated) scans
  // count toward a plan's manual weekly/monthly quota; SCHEDULED (cron) and
  // AUTO_PUBLISH (theme-publish auto-rescan) scans are exempt so a scheduled or
  // auto scan can never block a merchant's manual scan (GC-iji). Defaults to
  // MANUAL, which correctly backfills all pre-existing rows (historically every
  // scan was merchant-initiated).
  origin            ScanOrigin      @default(MANUAL)
  // Scan-differ new/resolved/unchanged counts vs the previous completed scan for
  // this theme (gc scan-signals). Default 0 correctly backfills legacy rows: no
  // diff was ever computed for them, so they carry no resolution signal.
  newFindingCount       Int          @default(0) // findings not present in the prior scan
  resolvedFindingCount  Int          @default(0) // prior findings no longer present (fixed)
  persistedFindingCount Int          @default(0) // findings unchanged / carried forward
  findings          Finding[]
  unknownScripts    UnknownScript[]
  scanDomains       ScanDomain[]

  @@index([shopId, createdAt])
  @@index([status, startedAt])
  @@index([status, createdAt])
}

// ---------------------------------------------------------------------------
// Unknown script collection + merchant feedback for signature expansion
// ---------------------------------------------------------------------------

model UnknownScript {
  id           String                @id @default(cuid())
  scanId       String
  scan         Scan                  @relation(fields: [scanId], references: [id], onDelete: Cascade)
  filename     String
  lineNumber   Int
  url          String
  resourceType String
  codeSnippet  String
  createdAt    DateTime              @default(now())
  submissions  SignatureSubmission[]
  // Hostname of `url`, computed at insert time (gc-06e.10). Enables an indexed
  // exact-match lookup in acceptSubmissionsForDomain instead of a non-indexable
  // `url contains` substring scan. Nullable: rows created before this column
  // existed have null and are matched via the legacy contains fallback.
  domain       String?

  @@index([scanId])
  @@index([domain])
}

model SignatureSubmission {
  id               String           @id @default(cuid())
  unknownScriptId  String
  unknownScript    UnknownScript    @relation(fields: [unknownScriptId], references: [id], onDelete: Cascade)
  shopId           String
  suggestedAppName String
  status           SubmissionStatus @default(PENDING)
  reviewedAt       DateTime?
  createdAt        DateTime         @default(now())

  @@index([unknownScriptId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Third-party domain graph — one row per (scanId, domain), deduped across the
// surfaces that referenced it (gc scan-signals, Feature 1). Captures the full
// set of NON-Shopify hosts a theme talks to: matched-to-an-app, benign public
// CDN/web-font, or neither (a signature-flywheel candidate). Shopify first-party
// hosts are intentionally NOT persisted (noise).
// ---------------------------------------------------------------------------
model ScanDomain {
  id        String   @id @default(cuid())
  scanId    String
  scan      Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)
  domain    String // hostname, e.g. "cdn.example.com"
  sources   String[] @default([]) // surfaces that referenced it: script|stylesheet|preconnect|dns_prefetch|font|ajax
  refCount  Int      @default(0) // total references across the theme
  matched   Boolean  @default(false) // true if `domain` resolved to a known app signature
  appName   String? // set when matched
  benign    Boolean  @default(false) // true if a known benign public CDN / web-font host
  createdAt DateTime @default(now())

  @@index([scanId])
  @@index([domain]) // cross-scan market-intel / flywheel queries
}

model Finding {
  id          String      @id @default(cuid())
  scanId      String
  scan        Scan        @relation(fields: [scanId], references: [id], onDelete: Cascade)
  filename    String
  lineNumber  Int
  codeSnippet String
  findingType FindingType
  severity    Severity
  appName     String?
  description String
  createdAt   DateTime    @default(now())

  @@index([scanId])
  @@index([severity])
}

// ---------------------------------------------------------------------------
// False-positive suppression (E2 epic gc-gis).
//
// A merchant can suppress a finding they've judged a false positive at two
// granularities, both stored in this ONE table and disambiguated by `scope`:
//
//   scope = INSTANCE  fingerprint set, appName null — suppress this one specific
//                     finding across re-scans. `fingerprint` is the stable hex
//                     string from fingerprintFinding(filename, findingType,
//                     codeSnippet, lineNumber) in scan-differ.server.ts — the
//                     SAME identity the diff engine uses, so an ignore survives
//                     re-scans exactly as long as the finding's identity does.
//
//   scope = APP       appName set, fingerprint null — bulk-suppress every finding
//                     attributed to a given app (Finding.appName), e.g. "stop
//                     flagging Judge.me" (the M2 bulk mechanism).
//
// Suppression is purely additive/reversible: deleting a row un-ignores. No
// filtering logic lives here — the aggregation choke point (E2.2) reads
// getIgnoredFindingsForShop and filters a scan's findings itself.
//
// Two partial uniques enforce idempotency per granularity. Postgres treats NULLs
// as distinct in a unique index, so the null column in each constraint never
// collides: many APP rows (fingerprint NULL) coexist under
// @@unique([shopId, fingerprint]), and many INSTANCE rows (appName NULL) coexist
// under @@unique([shopId, appName]). A repeat ignore of the same
// (shopId, fingerprint) or (shopId, appName) hits the constraint, so the model
// wrapper upserts to stay idempotent.
// ---------------------------------------------------------------------------
model IgnoredFinding {
  id          String      @id @default(cuid())
  shopId      String
  shop        Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  scope       IgnoreScope
  // Set for INSTANCE scope (fingerprintFinding hex); null for APP scope.
  fingerprint String?
  // Set for APP scope (maps to Finding.appName); null for INSTANCE scope.
  appName     String?
  // Optional merchant note on why this was suppressed.
  reason      String?
  createdAt   DateTime    @default(now())

  @@unique([shopId, fingerprint])
  @@unique([shopId, appName])
  @@index([shopId])
  // NOTE: the migration (20260911130000_add_ignored_finding) also adds a CHECK
  // constraint `IgnoredFinding_scope_key_check` enforcing that EXACTLY one of
  // `fingerprint` / `appName` is non-null (XOR): (fingerprint IS NOT NULL) <>
  // (appName IS NOT NULL). Prisma cannot express a CHECK natively, so it exists
  // only in SQL — do not be surprised by this schema/DB drift.
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

// Granularity of a false-positive suppression (see IgnoredFinding).
enum IgnoreScope {
  // Suppress one specific finding identity (keyed by fingerprint) across re-scans.
  INSTANCE
  // Bulk-suppress every finding attributed to an app (keyed by appName).
  APP
}

// Which surface initiated a scan. Drives manual-quota exemption (GC-iji):
// only MANUAL scans count against a plan's manual weekly/monthly scan limit.
enum ScanOrigin {
  // Merchant clicked "Scan" in the app UI. Counts toward the manual quota.
  MANUAL
  // Weekly cron (poll-check-shop). Exempt from the manual quota.
  SCHEDULED
  // Theme-publish auto-rescan webhook (Professional). Exempt from the manual quota.
  AUTO_PUBLISH
}

enum ScanStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  // The core theme scan succeeded and the scan is usable, but one or more
  // OPTIONAL audit categories were skipped because their Shopify scope was not
  // granted (ACCESS_DENIED) — i.e. not a full audit. Treated as a successful,
  // usable terminal status everywhere COMPLETED is (quota, dashboard, diffing).
  PARTIAL
  FAILED
}

enum FindingType {
  GHOST_SCRIPT
  GHOST_STYLE
  GHOST_SNIPPET
  GHOST_SECTION
  GHOST_HREFLANG
  ORPHAN_ASSET
  DUPLICATE_META
  GHOST_JSON_LD
  GHOST_TEXT
  GHOST_TRANSLATION
  SETTINGS_DRIFT
  GHOST_PIXEL
  JSON_LD_CONFLICT
  // Emitted EXCLUSIVELY by the live-price audit (jsonld-price-audit.server.ts):
  // a static Product JSON-LD block advertises a price/availability that no longer
  // matches the live product. Kept distinct from JSON_LD_CONFLICT (the worker's
  // same-file conflict detector) so skippedCategories can scope-gate only this
  // audit without over-excluding the worker's findings (gc-47c.10 fix).
  JSON_LD_PRICE_CONFLICT
  // Emitted by the malformed-JSON-LD detector (detectInvalidJsonLd in
  // scan-engine.server.ts): a STATIC `application/ld+json` block fails JSON.parse,
  // so search engines and AI answer/shopping agents discard it wholesale and the
  // product/page becomes invisible to structured-data consumers. Liquid-templated
  // blocks are excluded (their raw form legitimately isn't valid JSON). Theme-file
  // only, no scope gate, all plans.
  JSON_LD_INVALID
  GHOST_LAYOUT
  GHOST_TAG
  GHOST_PRICE
  GHOST_PAGE
  GHOST_METAFIELD
  GHOST_REDIRECT
  GHOST_ROBOTS
  GHOST_CANONICAL
  GHOST_TITLE
  GHOST_OG
  GHOST_PRECONNECT
  GHOST_FONT
  GHOST_AJAX
  DUPLICATE_LIBRARY
  // Emitted by the dangling-reference audit (gc-m4h): theme code statically
  // references a shop entity (product / collection / page) that no longer exists
  // in the Admin. ONE FindingType covers all entity subtypes; the subtype is
  // carried at runtime in `description` + `appName` (no JSON column on Finding).
  DANGLING_REFERENCE
  // Emitted by the checkout-extensibility sunset auditor (gc-b3c): the theme
  // still contains `layout/checkout.liquid`, a retired customization mechanism:
  // Shopify stopped rendering it for Information/Shipping/Payment on Aug 13,
  // 2024 and for the Thank you/Order status pages on Aug 28, 2025.
  // ONE FindingType covers all customization-depth subtypes (scripts / tracking
  // / snippets / content-injection / layout); the subtype is carried at runtime
  // in `description` + `appName` (no JSON column on Finding), mirroring
  // DANGLING_REFERENCE.
  CHECKOUT_SUNSET
  // Emitted by the cross-file duplicate-tracker detector (detectDuplicateTrackers
  // in scan-engine.server.ts): the same analytics/pixel platform (GA4, GTM, Meta
  // Pixel, Universal Analytics, TikTok) is configured with two or more DISTINCT
  // IDs across the theme, so events double-count or split across properties and
  // corrupt reporting. A single ID, or the same ID repeated, is normal and never
  // flagged. Theme-file only, no scope gate, all plans. Like DUPLICATE_LIBRARY it
  // is cross-file with no single-app attribution.
  DUPLICATE_TRACKER
  // Emitted by the cross-file overlapping-chat-widget detector
  // (detectOverlappingChatWidgets in scan-engine.server.ts): two or more DISTINCT
  // chat-widget platforms (Intercom, Drift, Tidio, etc.) are present in the theme
  // at once, so shoppers see conflicting chat bubbles / sessions. One platform,
  // even if referenced multiple times, is never flagged. Theme-file only, no scope
  // gate, all plans. Like DUPLICATE_LIBRARY it is cross-file with no single-app
  // attribution.
  OVERLAPPING_CHAT_WIDGET
  // Emitted by the malicious-script detector (detectMaliciousScripts in
  // scan-engine.server.ts): a live theme line references a domain on the curated
  // KNOWN_MALICIOUS_DOMAINS list (app/data/malicious-domains.server.ts), e.g. a
  // fake-CDN loader injected by a rogue app. Always HIGH. Theme-file only, no
  // scope gate, all plans; preferred as the free-plan preview finding.
  MALICIOUS_SCRIPT
}

enum SubmissionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum Severity {
  HIGH
  MEDIUM
  LOW
}

// ---------------------------------------------------------------------------
// Admin metrics snapshots — one per day, computed by daily cron
// ---------------------------------------------------------------------------

model MetricSnapshot {
  id                 String   @id @default(cuid())
  snapshotDate       DateTime @unique // one per day
  totalShops         Int
  activeShops        Int // shops with a scan in last 30 days
  shopsByPlan        Json // { free: N, professional: N, business: N }
  totalScans         Int // all-time
  scansLast7d        Int
  scansLast30d       Int
  completionRate     Float // completed / (completed + failed) last 30d
  totalFindings      Int // all-time
  avgFindingsPerScan Float
  createdAt          DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Ops events — one unified append-only log backing observability features
// (gc-06e.1). A single table serves the cron heartbeat / dead-man's-switch,
// the function-failure log, and the future daily ops digest (gc-bny) so we do
// not proliferate one table per signal.
//
//   eventType = "cron_heartbeat"   key = inngest function id (latest = liveness)
//   eventType = "function_failure" key = inngest function id (counted per window)
//   eventType = "worker_fallback"  key = scan-pool signal; live — scan-pool.server.ts
//                                  escalates to function_failure + ops-alert after
//                                  3 fallbacks in 30m, and the daily digest counts it
//
// Append-only and best-effort: writes never block the caller. Reads derive the
// heartbeat (latest per key) and failure counts (count in a window).
// ---------------------------------------------------------------------------
model OpsEvent {
  id        String   @id @default(cuid())
  eventType String
  key       String?
  message   String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([eventType, createdAt])
  @@index([key, createdAt])
}
