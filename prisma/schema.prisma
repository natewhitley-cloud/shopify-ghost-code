// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Shopify session storage — keep exactly as-is; used by
// @shopify/shopify-app-session-storage-prisma
// ---------------------------------------------------------------------------
model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?

  @@index([shop])
}

// ---------------------------------------------------------------------------
// Ghost Code domain models
// ---------------------------------------------------------------------------

model Shop {
  id                  String           @id @default(cuid())
  domain              String           @unique
  installedAt         DateTime         @default(now())
  plan                String           @default("free")
  // Last time `plan` was reconciled against Shopify's actual active
  // subscriptions (or refreshed by an APP_SUBSCRIPTIONS_UPDATE webhook). Null
  // means never reconciled. Drives the app-load freshness guard so the
  // reconciliation GraphQL query runs at most once per freshness window.
  planReconciledAt    DateTime?
  // Marks an uninstalled-but-not-yet-redacted shop. Null = active install; set =
  // the merchant uninstalled (app/uninstalled fired) and the row is pending the
  // shop/redact hard-delete within the 48h GDPR grace window; cleared back to null
  // on reinstall (see upsertShop). Iterators/metrics exclude non-null rows so a
  // dead shop is never scanned or counted as an active install (gc-grd).
  uninstalledAt       DateTime?
  // Last time a merchant loaded any authenticated app page (freshness-gated
  // write). Null = never seen since this column shipped. Durable "last login";
  // survives beyond the page_visit event retention window. Cleared/kept across
  // reconciles; removed on shop delete (GDPR cascade).
  lastSeenAt          DateTime?
  lastThemePublishAt  DateTime?
  // RETIRED (owner decision 2A, 2026-09-26): backed the former home-page App
  // Store review banner, which no longer exists. Nothing reads or writes it;
  // kept (not dropped) so the change stays additive.
  hasSeenReviewPrompt Boolean          @default(false)
  // Durable "internal/dev/test store — excluded from all business metrics" flag;
  // the PRIMARY exclusion signal (the env exclude list + `app-review-` prefix
  // remain as an operational override + ephemeral-review-store coverage). Set
  // once per known internal store so a rename never re-leaks it into metrics.
  isInternal          Boolean          @default(false)
  // Free-tier upgrade-preview nudge funnel (gc-97k.4). Each is stamped ONCE, on
  // the first time the stage happens, via an atomic conditional updateMany
  // (where <col> IS NULL); the nudge_* OpsEvent is emitted only when that claim
  // wins, so each stage counts at most once per merchant. Null = the stage has
  // not happened. Deleted with the Shop row on shop/redact (deleteShopData).
  upgradePreviewShownAt     DateTime?
  upgradePreviewClickedAt   DateTime?
  upgradePreviewConvertedAt DateTime?
  // Merchant feedback nudge funnel (gc-97k.3). Same once-per-merchant atomic
  // claim as the upgrade-preview stamps above (claimShopStamp). Dismissed or
  // submitted permanently suppresses the home-page nudge; feedbackSubmittedAt is
  // the FIRST submission only (later MerchantFeedback rows do not re-stamp it).
  feedbackNudgeShownAt      DateTime?
  feedbackNudgeClickedAt    DateTime?
  feedbackNudgeDismissedAt  DateTime?
  feedbackSubmittedAt       DateTime?
  // Durable journey milestones (gc-dpm.1). Stamped ONCE via the same atomic
  // claim as the nudge stamps (claimShopStamp): firstOpenedAt on the first
  // authenticated app load, firstResultsViewedAt on the first load of a
  // successful (COMPLETED/PARTIAL) scan's detail page, or of Home with a
  // successful latest scan (it renders that scan's results). Unlike page_visit rows
  // (pruned at 14 days) these never age out. Null = not happened, or (for shops
  // whose history predates the 14-day page_visit window at backfill) unknown.
  firstOpenedAt             DateTime?
  firstResultsViewedAt      DateTime?
  // Cross-prompt frequency cap (gc-97k.6): the interruptive prompt (a
  // PROMPT_KEYS value in app/lib/prompt-cap.ts) that last opened the shop's 24h
  // prompt window, and when. Rewritten (not once-ever) whenever a different
  // prompt renders or the window has expired, via a conditional updateMany keyed
  // on the previous values (claimPromptSlot). Null = no prompt shown since this
  // column shipped. Deleted with the Shop row on shop/redact.
  lastPromptKey             String?
  lastPromptShownAt         DateTime?
  // Native App Store review popup (gc-97k.7): when App Bridge
  // (shopify.reviews.request) reported a TERMINAL result (displayed, closed, or
  // Shopify will never show it to this merchant). Stamped ONCE ever, so the
  // request is never repeated. Null = not done yet. Deleted with the Shop row
  // on shop/redact.
  reviewPopupRequestedAt    DateTime?
  // Review popup attempts and results (audit fix, gc-97k.7). reviewPopupRequestedAt
  // above is stamped ONLY by a TERMINAL result (app/lib/review-request.ts
  // REVIEW_RESULT_POLICY). A RETRYABLE result sets reviewPopupRetryAfter. The
  // loader records each attempt (count + 1, lastAttemptAt = now) before the
  // client asks, so a lost result report retries after 24h and stops at 5.
  // reviewPopupLastResult is the last reported code (null = attempt in flight).
  reviewPopupRetryAfter     DateTime?
  reviewPopupAttemptCount   Int       @default(0)
  reviewPopupLastAttemptAt  DateTime?
  reviewPopupLastResult     String?
  // The prompt slot an attempt replaced when it claimed the slot (audit fix):
  // a non-success result hands the slot back to exactly this holder.
  reviewPopupPrevPromptKey     String?
  reviewPopupPrevPromptShownAt DateTime?
  // Return-visit upgrade nudge, Free only (gc-97k.9). Episode state: when the
  // current weekly episode started (plain update each new episode), when the
  // merchant last clicked "Not now" (ends the episode early), and how many
  // times they have (3 retires the nudge; atomic increment).
  upgradeReturnLastShownAt     DateTime?
  upgradeReturnLastDismissedAt DateTime?
  upgradeReturnDismissCount    Int       @default(0)
  // Funnel stamps: once per merchant via claimShopStamp, same as the
  // upgrade-preview stamps above. Deleted with the Shop row on shop/redact.
  upgradeReturnShownAt         DateTime?
  upgradeReturnClickedAt       DateTime?
  upgradeReturnDismissedAt     DateTime?
  upgradeReturnConvertedAt     DateTime?
  // Stale-results banner (gc-mgi): funnel stamps for its upgrade ask, shown
  // only to a Free shop whose quota blocks a rescan of results the theme has
  // changed since. Once per merchant via claimShopStamp. No dismiss control,
  // so no dismissed stamp. Deleted with the Shop row on shop/redact.
  staleResultsShownAt          DateTime?
  staleResultsClickedAt        DateTime?
  staleResultsConvertedAt      DateTime?
  // Durable "has ever been on a paid plan" (audit fix, gc-97k.8). Stamped ONCE,
  // via claimShopStamp, the first time reconcileShopPlan observes a paid plan
  // (every reconcile path: redirect and stale/backstop). Backfilled from
  // BillingEvent history and the current plan. The free-trial CTA is promised
  // only while this is null AND the shop has no BillingEvent. Deleted with the
  // Shop row on shop/redact, so a reinstall after redact looks never-paid
  // (accepted).
  everPaidAt                   DateTime?
  // Merchant monitoring alerts (gc-syz.1). alertsEnabled is the per-shop opt-out
  // (default on: transactional monitoring mail). alertEmail caches the shop-owner
  // email from Admin `shop { email }` (personal data: cleared with the Shop row on
  // shop/redact). alertUnsubscribeToken is the opaque, lazily minted token behind
  // the public one-click unsubscribe link.
  alertsEnabled                Boolean   @default(true)
  alertEmail                   String?
  alertUnsubscribeToken        String?   @unique
  // gc-frda: the scan whose "no longer active" / "cleaned up" Home banner the
  // merchant dismissed. The banner hides only for that scan; a newer scan's
  // banner shows again. Null = never dismissed. Plain id (no FK).
  removalNoticeDismissedScanId String?
  scans               Scan[]
  billingEvents       BillingEvent[]
  ignoredFindings     IgnoredFinding[]
  merchantFeedback    MerchantFeedback[]
  merchantAlerts      MerchantAlert[]
  appRemovals         AppRemoval[]
}

// Ledger of merchant-facing "new findings" alert emails (gc-syz.1): the dedup
// (findingSetHash) and rate-limit (sentAt) source for gc-syz.4. A dedicated table,
// NOT OpsEvent, so it cascades with the Shop. `recipient` is the merchant's email
// (personal data), so deleteShopData also deletes these rows explicitly. scanId is
// a plain string (no FK): the ledger must outlive a pruned/rescanned Scan row.
model MerchantAlert {
  id             String   @id @default(cuid())
  shopId         String
  shop           Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  scanId         String
  findingSetHash String
  newCount       Int
  recipient      String
  sentAt         DateTime @default(now())

  @@index([shopId, sentAt])
}

// Merchant feedback survey submissions (gc-97k.3, ported from ClearSignal
// ba-1zbf.1). CSAT 1-5 is required; the three open-text answers and the
// follow-up email are optional (null = left blank). Several rows per shop are
// allowed. Cascade-deleted with the Shop, and ALSO deleted explicitly in
// deleteShopData (the email is personal data, so the redact path names it).
model MerchantFeedback {
  id           String   @id @default(cuid())
  shopId       String
  shop         Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  csat         Int
  valuable     String?
  improvement  String?
  wtp          String?
  contactEmail String?
  createdAt    DateTime @default(now())

  @@index([shopId])
  @@index([createdAt])
}

// An app no longer active on a theme that left code behind (gc-frda, Rule
// 1D): it had a live hook (enabled app embed or storefront ScriptTag) on the
// previous successful scan of the same shop + theme, has none on this scan,
// and this scan still finds its code (see app/services/app-removal.server.ts
// for the hook, coverage, signature and ignore guards). Merchant meaning: "X
// is no longer active in your store. It left N items behind." Never a claim
// that the merchant uninstalled it. Rows are never deleted on reinstall (a
// removal during testing still counts); later scans move a REMOVED row to
// CLEANED or REINSTALLED. Holds no personal data; deleted with the Shop row on
// shop/redact via the cascading FK.
model AppRemoval {
  id                 String          @id @default(cuid())
  shopId             String
  shop               Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  themeId            String
  appName            String
  // The scan that first saw the leftovers, and the baseline it was compared to.
  // Plain ids (no FK): the record outlives a pruned scan.
  detectedScanId     String
  previousScanId     String
  // Audited, non-ignored findings attributed to the app on the latest scan
  // that evaluated this row while REMOVED. A CLEANED row keeps its last
  // REMOVED count: what was cleaned up ("The N items X left behind are gone").
  leftoverCount      Int
  state              AppRemovalState @default(REMOVED)
  detectedAt         DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  // When `state` last changed, and the scan that changed it (Home's "cleaned
  // up on this scan" banner); both null while still REMOVED. Plain id, no FK.
  stateChangedAt     DateTime?
  stateChangedScanId String?

  // Idempotency: an Inngest retry of the same scan cannot insert twice.
  @@unique([shopId, themeId, appName, detectedScanId])
  @@index([shopId, detectedAt])
}

model BillingEvent {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  eventType String // "upgrade" | "downgrade" | "cancellation" | "reactivation"
  fromPlan  String? // null for first subscription
  toPlan    String? // null for cancellation
  amount    Float? // monthly price of toPlan, null for cancellation
  createdAt DateTime @default(now())

  @@index([shopId])
  @@index([createdAt])
  @@index([eventType])
}

model Scan {
  id                String          @id @default(cuid())
  shopId            String
  shop              Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  themeId           String
  themeName         String
  status            ScanStatus      @default(PENDING)
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime        @default(now())
  findingCount      Int             @default(0)
  // FindingType categories whose OPTIONAL audit was skipped this run because the
  // required Shopify scope was not granted (ACCESS_DENIED). Drives PARTIAL status
  // and prevents the diff engine from falsely marking un-audited categories as
  // "resolved" (LOG-4). Empty for fully-audited scans and all legacy scans.
  // Scope-only (gc-11f): a size cap never lands here, see cappedCategories.
  skippedCategories String[]        @default([])
  // FindingType categories whose OPTIONAL audit ran (scope granted) but hit a
  // size cap this run, so only part of the category was checked (gc-11f). The
  // differ excludes skipped + capped from "resolved"; the scan-detail UI shows
  // an info notice (not the permissions warning). Does NOT change status.
  // Empty for uncapped scans and all legacy scans.
  cappedCategories  String[]        @default([])
  // FindingType categories whose check could not run this scan because the
  // shop's PUBLIC storefront homepage could not be read (password page, timeout,
  // non-2xx, not a Shopify storefront, unparseable script-tag block). Only the
  // SCRIPT_TAG_SUNSET check reads the storefront today. Treated as un-audited
  // exactly like skipped/capped (the differ never resolves its prior findings),
  // but it is NOT a scope problem: no permissions banner, no PARTIAL status; the
  // scan-detail UI shows an info notice. Empty for every scan while the check is
  // dark, and for all legacy scans.
  unreachableCategories String[]    @default([])
  // Theme file paths whose per-file detectors were SKIPPED this run because the
  // file exceeded MAX_SCANNABLE_FILE_BYTES (gc-06e.19). Those files were not
  // scanned, so the diff engine must exclude their prior findings from
  // "resolved" — an unscanned file is unknown, not fixed. Also surfaced in the
  // scan-detail UI. Empty for fully-scanned scans and all legacy scans.
  skippedFiles      String[]        @default([])
  // FindingType values whose detectors were LIVE (existed in code AND were not
  // suppressed by a soft-launch flag) when this scan persisted its findings,
  // stored as a JSON string array (gc-rvo0). Json? rather than String[] because
  // Prisma scalar lists are non-null: NULL must mean "legacy scan, never
  // recorded" (distinct from an empty set). Alert-only: the merchant-alert diff
  // restricts "new" to types live in BOTH the baseline and current scan, so a
  // flag flip or newly shipped detector cannot blast every shop. The in-app diff
  // ignores it.
  liveFindingTypes  Json?
  // Which surface initiated this scan. Only MANUAL (merchant-initiated) scans
  // count toward a plan's manual weekly/monthly quota; SCHEDULED (cron) and
  // AUTO_PUBLISH (theme-publish auto-rescan) scans are exempt so a scheduled or
  // auto scan can never block a merchant's manual scan (GC-iji). Defaults to
  // MANUAL, which correctly backfills all pre-existing rows (historically every
  // scan was merchant-initiated).
  origin            ScanOrigin      @default(MANUAL)
  // Scan-differ new/resolved/unchanged counts vs the previous completed scan for
  // this theme (gc scan-signals). Default 0 correctly backfills legacy rows: no
  // diff was ever computed for them, so they carry no resolution signal.
  newFindingCount       Int          @default(0) // findings not present in the prior scan
  resolvedFindingCount  Int          @default(0) // prior findings no longer present (fixed)
  persistedFindingCount Int          @default(0) // findings unchanged / carried forward
  // Scan start-source + results-view telemetry (operator digest only; never
  // read for gating). All null on rows created before the feature shipped.
  // requestedFrom: page a MANUAL scan was started from ("home" | "scan_page" |
  // "unknown", see app/lib/scan-source.ts); null for SCHEDULED/AUTO_PUBLISH.
  requestedFrom      String?
  // 1-based order of this scan among ALL the shop's scans (every origin and
  // status) at creation time; 1 = the shop's first scan. Set inside
  // createScan's transaction, after the active-scan guard.
  shopScanNumber     Int?
  // First time each page rendered this scan's RESULTS (successful scans only),
  // claimed once via a conditional update.
  viewedOnHomeAt     DateTime?
  viewedOnScanPageAt DateTime?
  // App-removal detection (gc-frda): a fingerprint of each app's signature in
  // APP_SIGNATURES when this scan ran, as a JSON object { [appName]: hash }.
  // A removal of app X is only inferred between two scans whose fingerprints
  // for X are equal, so a signature edit (new pattern or domain) that makes
  // existing leftover code newly match X is never mistaken for an uninstall.
  // NULL = legacy scan, never recorded: no removal is inferred against it.
  appSignatureFingerprints Json?
  // App-removal detection (gc-frda): apps with a LIVE HOOK on this scan, as
  // { embedApps: string[] | null, scriptTagApps: string[] | null }: an enabled
  // theme app embed, or a storefront ScriptTag. null for a source = not
  // observed this scan (ScriptTag check dark, unreachable or capped). A
  // removal needs a hook in the previous scan that is gone in this one.
  // NULL column = legacy scan: no removal is inferred against it.
  liveAppHooks      Json?
  findings          Finding[]
  unknownScripts    UnknownScript[]
  scanDomains       ScanDomain[]

  @@index([shopId, createdAt])
  @@index([status, startedAt])
  @@index([status, createdAt])
}

// ---------------------------------------------------------------------------
// Unknown script collection + merchant feedback for signature expansion
// ---------------------------------------------------------------------------

model UnknownScript {
  id           String                @id @default(cuid())
  scanId       String
  scan         Scan                  @relation(fields: [scanId], references: [id], onDelete: Cascade)
  filename     String
  lineNumber   Int
  url          String
  resourceType String
  codeSnippet  String
  createdAt    DateTime              @default(now())
  submissions  SignatureSubmission[]
  // Hostname of `url`, computed at insert time (gc-06e.10). Enables an indexed
  // exact-match lookup in acceptSubmissionsForDomain instead of a non-indexable
  // `url contains` substring scan. Nullable: rows created before this column
  // existed have null and are matched via the legacy contains fallback.
  domain       String?

  @@index([scanId])
  @@index([domain])
}

model SignatureSubmission {
  id               String           @id @default(cuid())
  unknownScriptId  String
  unknownScript    UnknownScript    @relation(fields: [unknownScriptId], references: [id], onDelete: Cascade)
  shopId           String
  suggestedAppName String
  status           SubmissionStatus @default(PENDING)
  reviewedAt       DateTime?
  createdAt        DateTime         @default(now())

  @@index([unknownScriptId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Third-party domain graph — one row per (scanId, domain), deduped across the
// surfaces that referenced it (gc scan-signals, Feature 1). Captures the full
// set of NON-Shopify hosts a theme talks to: matched-to-an-app, benign public
// CDN/web-font, or neither (a signature-flywheel candidate). Shopify first-party
// hosts are intentionally NOT persisted (noise).
// ---------------------------------------------------------------------------
model ScanDomain {
  id        String   @id @default(cuid())
  scanId    String
  scan      Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)
  domain    String // hostname, e.g. "cdn.example.com"
  sources   String[] @default([]) // surfaces that referenced it: script|stylesheet|preconnect|dns_prefetch|font|ajax
  refCount  Int      @default(0) // total references across the theme
  matched   Boolean  @default(false) // true if `domain` resolved to a known app signature
  appName   String? // set when matched
  benign    Boolean  @default(false) // true if a known benign public CDN / web-font host
  createdAt DateTime @default(now())

  @@index([scanId])
  @@index([domain]) // cross-scan market-intel / flywheel queries
}

model Finding {
  id          String      @id @default(cuid())
  scanId      String
  scan        Scan        @relation(fields: [scanId], references: [id], onDelete: Cascade)
  filename    String
  lineNumber  Int
  codeSnippet String
  findingType FindingType
  severity    Severity
  appName     String?
  description String
  createdAt   DateTime    @default(now())

  @@index([scanId])
  @@index([severity])
}

// ---------------------------------------------------------------------------
// False-positive suppression (E2 epic gc-gis).
//
// A merchant can suppress a finding they've judged a false positive at two
// granularities, both stored in this ONE table and disambiguated by `scope`:
//
//   scope = INSTANCE  fingerprint set, appName null — suppress this one specific
//                     finding across re-scans. `fingerprint` is the stable hex
//                     string from fingerprintFinding(filename, findingType,
//                     codeSnippet, lineNumber) in scan-differ.server.ts — the
//                     SAME identity the diff engine uses, so an ignore survives
//                     re-scans exactly as long as the finding's identity does.
//
//   scope = APP       appName set, fingerprint null — bulk-suppress every finding
//                     attributed to a given app (Finding.appName), e.g. "stop
//                     flagging Judge.me" (the M2 bulk mechanism).
//
// Suppression is purely additive/reversible: deleting a row un-ignores. No
// filtering logic lives here — the aggregation choke point (E2.2) reads
// getIgnoredFindingsForShop and filters a scan's findings itself.
//
// Two partial uniques enforce idempotency per granularity. Postgres treats NULLs
// as distinct in a unique index, so the null column in each constraint never
// collides: many APP rows (fingerprint NULL) coexist under
// @@unique([shopId, fingerprint]), and many INSTANCE rows (appName NULL) coexist
// under @@unique([shopId, appName]). A repeat ignore of the same
// (shopId, fingerprint) or (shopId, appName) hits the constraint, so the model
// wrapper upserts to stay idempotent.
// ---------------------------------------------------------------------------
model IgnoredFinding {
  id          String      @id @default(cuid())
  shopId      String
  shop        Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  scope       IgnoreScope
  // Set for INSTANCE scope (fingerprintFinding hex); null for APP scope.
  fingerprint String?
  // Set for APP scope (maps to Finding.appName); null for INSTANCE scope.
  appName     String?
  // Optional merchant note on why this was suppressed.
  reason      String?
  createdAt   DateTime    @default(now())

  @@unique([shopId, fingerprint])
  @@unique([shopId, appName])
  @@index([shopId])
  // NOTE: the migration (20260911130000_add_ignored_finding) also adds a CHECK
  // constraint `IgnoredFinding_scope_key_check` enforcing that EXACTLY one of
  // `fingerprint` / `appName` is non-null (XOR): (fingerprint IS NOT NULL) <>
  // (appName IS NOT NULL). Prisma cannot express a CHECK natively, so it exists
  // only in SQL — do not be surprised by this schema/DB drift.
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

// Lifecycle of an AppRemoval (gc-frda).
enum AppRemovalState {
  // Leftover code from the app is still in the theme.
  REMOVED
  // A later scan found none of the app's leftover code.
  CLEANED
  // A later scan observed the app's live hook again (embed or ScriptTag).
  REINSTALLED
}

// Granularity of a false-positive suppression (see IgnoredFinding).
enum IgnoreScope {
  // Suppress one specific finding identity (keyed by fingerprint) across re-scans.
  INSTANCE
  // Bulk-suppress every finding attributed to an app (keyed by appName).
  APP
}

// Which surface initiated a scan. Drives manual-quota exemption (GC-iji):
// only MANUAL scans count against a plan's manual weekly/monthly scan limit.
enum ScanOrigin {
  // Merchant clicked "Scan" in the app UI. Counts toward the manual quota.
  MANUAL
  // Weekly cron (poll-check-shop). Exempt from the manual quota.
  SCHEDULED
  // Theme-publish auto-rescan webhook (Professional). Exempt from the manual quota.
  AUTO_PUBLISH
}

enum ScanStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  // The core theme scan succeeded and the scan is usable, but one or more
  // OPTIONAL audit categories were skipped because their Shopify scope was not
  // granted (ACCESS_DENIED) — i.e. not a full audit. Treated as a successful,
  // usable terminal status everywhere COMPLETED is (quota, dashboard, diffing).
  PARTIAL
  FAILED
}

enum FindingType {
  GHOST_SCRIPT
  GHOST_STYLE
  GHOST_SNIPPET
  GHOST_SECTION
  GHOST_HREFLANG
  ORPHAN_ASSET
  DUPLICATE_META
  GHOST_JSON_LD
  GHOST_TEXT
  GHOST_TRANSLATION
  SETTINGS_DRIFT
  GHOST_PIXEL
  JSON_LD_CONFLICT
  // Emitted EXCLUSIVELY by the live-price audit (jsonld-price-audit.server.ts):
  // a static Product JSON-LD block advertises a price/availability that no longer
  // matches the live product. Kept distinct from JSON_LD_CONFLICT (the worker's
  // same-file conflict detector) so skippedCategories can scope-gate only this
  // audit without over-excluding the worker's findings (gc-47c.10 fix).
  JSON_LD_PRICE_CONFLICT
  // Emitted by the malformed-JSON-LD detector (detectInvalidJsonLd in
  // scan-engine.server.ts): a STATIC `application/ld+json` block fails JSON.parse,
  // so search engines and AI answer/shopping agents discard it wholesale and the
  // product/page becomes invisible to structured-data consumers. Liquid-templated
  // blocks are excluded (their raw form legitimately isn't valid JSON). Theme-file
  // only, no scope gate, all plans.
  JSON_LD_INVALID
  GHOST_LAYOUT
  GHOST_TAG
  GHOST_PRICE
  GHOST_PAGE
  GHOST_METAFIELD
  GHOST_REDIRECT
  GHOST_ROBOTS
  GHOST_CANONICAL
  GHOST_TITLE
  GHOST_OG
  GHOST_PRECONNECT
  GHOST_FONT
  GHOST_AJAX
  DUPLICATE_LIBRARY
  // Emitted by the dangling-reference audit (gc-m4h): theme code statically
  // references a shop entity (product / collection / page) that no longer exists
  // in the Admin. ONE FindingType covers all entity subtypes; the subtype is
  // carried at runtime in `description` + `appName` (no JSON column on Finding).
  DANGLING_REFERENCE
  // Emitted by the checkout-extensibility sunset auditor (gc-b3c): the theme
  // still contains `layout/checkout.liquid`, a retired customization mechanism:
  // Shopify stopped rendering it for Information/Shipping/Payment on Aug 13,
  // 2024 and for the Thank you/Order status pages on Aug 28, 2025.
  // ONE FindingType covers all customization-depth subtypes (scripts / tracking
  // / snippets / content-injection / layout); the subtype is carried at runtime
  // in `description` + `appName` (no JSON column on Finding), mirroring
  // DANGLING_REFERENCE.
  CHECKOUT_SUNSET
  // Emitted by the cross-file duplicate-tracker detector (detectDuplicateTrackers
  // in scan-engine.server.ts): the same analytics/pixel platform (GA4, GTM, Meta
  // Pixel, Universal Analytics, TikTok) is configured with two or more DISTINCT
  // IDs across the theme, so events double-count or split across properties and
  // corrupt reporting. A single ID, or the same ID repeated, is normal and never
  // flagged. Theme-file only, no scope gate, all plans. Like DUPLICATE_LIBRARY it
  // is cross-file with no single-app attribution.
  DUPLICATE_TRACKER
  // Emitted by the cross-file overlapping-chat-widget detector
  // (detectOverlappingChatWidgets in scan-engine.server.ts): two or more DISTINCT
  // chat-widget platforms (Intercom, Drift, Tidio, etc.) are present in the theme
  // at once, so shoppers see conflicting chat bubbles / sessions. One platform,
  // even if referenced multiple times, is never flagged. Theme-file only, no scope
  // gate, all plans. Like DUPLICATE_LIBRARY it is cross-file with no single-app
  // attribution.
  OVERLAPPING_CHAT_WIDGET
  // Emitted by the app-embed audit (detectAppEmbedOff in scan-engine.server.ts,
  // gc-fed): a theme app embed entry in config/settings_data.json has
  // `disabled: true` (it was switched on once, then turned off), so an app that
  // moved off script tags (stopped 2027-03-01) may silently not run on the
  // storefront. Install state is unknowable, so wording is conditional.
  // Theme-file only, all plans; soft-launched behind APP_EMBED_LIVE_ENABLED.
  APP_EMBED_OFF
  // Emitted by the app-embed post-pass (detectGhostAppEmbeds, gc-fed): an ENABLED
  // app embed whose app (matched via a signature embedHandles entry) also left
  // other findings in the same scan, i.e. corroborating evidence the app is gone.
  // An enabled embed alone is never flagged. Theme-file only, all plans;
  // soft-launched behind APP_EMBED_LIVE_ENABLED.
  GHOST_APP_EMBED
  // Emitted by the malicious-script detector (detectMaliciousScripts in
  // scan-engine.server.ts): a live theme line references a domain on the curated
  // KNOWN_MALICIOUS_DOMAINS list (app/data/malicious-domains.server.ts), e.g. a
  // fake-CDN loader injected by a rogue app. Always HIGH. Theme-file only, no
  // scope gate, all plans; preferred as the free-plan preview finding.
  MALICIOUS_SCRIPT
  // Emitted by the storefront script-tag audit (script-tag-sunset-detector.server.ts):
  // an app still loads on the storefront through a ScriptTag, which Shopify stops
  // running on 2027-03-01 (create/update blocked since 2026-10-01). ScriptTags are
  // invisible in the admin and the Admin API only returns the calling app's own,
  // so they are read from the PUBLIC storefront homepage (content_for_header's
  // asyncLoad block). One finding per app (or host when unmatched). All plans;
  // soft-launched behind SCRIPT_TAG_SUNSET_LIVE_ENABLED, which also gates the
  // storefront request itself (flag off = no request at all).
  SCRIPT_TAG_SUNSET
}

enum SubmissionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum Severity {
  HIGH
  MEDIUM
  LOW
}

// ---------------------------------------------------------------------------
// Admin metrics snapshots — one per day, computed by daily cron
// ---------------------------------------------------------------------------

model MetricSnapshot {
  id                 String   @id @default(cuid())
  snapshotDate       DateTime @unique // one per day
  totalShops         Int
  activeShops        Int // shops with a scan in last 30 days
  shopsByPlan        Json // { free: N, professional: N, business: N }
  totalScans         Int // all-time
  scansLast7d        Int
  scansLast30d       Int
  completionRate     Float // completed / (completed + failed) last 30d
  totalFindings      Int // all-time
  avgFindingsPerScan Float
  createdAt          DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Ops events — one unified append-only log backing observability features
// (gc-06e.1). A single table serves the cron heartbeat / dead-man's-switch,
// the function-failure log, and the future daily ops digest (gc-bny) so we do
// not proliferate one table per signal.
//
//   eventType = "cron_heartbeat"   key = inngest function id (latest = liveness)
//   eventType = "function_failure" key = inngest function id (counted per window)
//   eventType = "worker_fallback"  key = scan-pool signal; live — scan-pool.server.ts
//                                  escalates to function_failure + ops-alert after
//                                  3 fallbacks in 30m, and the daily digest counts it
//
// Append-only and best-effort: writes never block the caller. Reads derive the
// heartbeat (latest per key) and failure counts (count in a window).
// ---------------------------------------------------------------------------
model OpsEvent {
  id        String   @id @default(cuid())
  eventType String
  key       String?
  message   String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([eventType, createdAt])
  @@index([key, createdAt])
}
