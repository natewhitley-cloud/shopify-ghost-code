// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Shopify session storage — keep exactly as-is; used by
// @shopify/shopify-app-session-storage-prisma
// ---------------------------------------------------------------------------
model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// ---------------------------------------------------------------------------
// Ghost Code domain models
// ---------------------------------------------------------------------------

model Shop {
  id                  String               @id @default(cuid())
  domain              String               @unique
  accessToken         String
  installedAt         DateTime             @default(now())
  plan                String               @default("free")
  lastThemePublishAt  DateTime?
  scans               Scan[]
  installedApps       InstalledApp[]
  permissionAuditRuns PermissionAuditRun[]
}

model Scan {
  id           String     @id @default(cuid())
  shopId       String
  shop         Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  themeId      String
  themeName    String
  status       ScanStatus @default(PENDING)
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime   @default(now())
  findingCount Int        @default(0)
  findings     Finding[]

  @@index([shopId, createdAt])
}

model Finding {
  id          String      @id @default(cuid())
  scanId      String
  scan        Scan        @relation(fields: [scanId], references: [id], onDelete: Cascade)
  filename    String
  lineNumber  Int
  codeSnippet String
  findingType FindingType
  severity    Severity
  appName     String?
  description String
  createdAt   DateTime    @default(now())

  @@index([scanId])
  @@index([severity])
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum ScanStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum FindingType {
  GHOST_SCRIPT
  GHOST_STYLE
  GHOST_SNIPPET
  GHOST_SECTION
  ORPHAN_ASSET
}

enum Severity {
  HIGH
  MEDIUM
  LOW
}

enum AppPresence {
  INSTALLED
  REMOVED
}

enum AuditRunStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

// ---------------------------------------------------------------------------
// Permission Audit models
// ---------------------------------------------------------------------------

model InstalledApp {
  id                    String               @id @default(cuid())
  shopId                String
  shop                  Shop                 @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopifyAppId          String
  appHandle             String
  appName               String
  appDescription        String?
  publicCategory        String?
  presence              AppPresence          @default(INSTALLED)
  grantedScopes         String               @default("[]")
  grantedScopeCount     Int                  @default(0)
  firstSeenAt           DateTime             @default(now())
  lastSeenAt            DateTime
  removedAt             DateTime?
  hasActiveSubscription Boolean              @default(false)
  permissionSnapshots   PermissionSnapshot[]

  @@unique([shopId, shopifyAppId])
  @@index([shopId])
  @@index([presence])
}

model PermissionSnapshot {
  id                   String             @id @default(cuid())
  installedAppId       String
  installedApp         InstalledApp       @relation(fields: [installedAppId], references: [id], onDelete: Cascade)
  auditRunId           String
  auditRun             PermissionAuditRun @relation(fields: [auditRunId], references: [id], onDelete: Cascade)
  grantedScopes        String
  scopeCount           Int
  unexpectedScopeCount Int                @default(0)
  riskScore            Float              @default(0)
  createdAt            DateTime           @default(now())

  @@index([installedAppId])
  @@index([auditRunId])
}

model PermissionAuditRun {
  id                  String               @id @default(cuid())
  shopId              String
  shop                Shop                 @relation(fields: [shopId], references: [id], onDelete: Cascade)
  status              AuditRunStatus       @default(PENDING)
  appCount            Int                  @default(0)
  totalRiskScore      Float                @default(0)
  startedAt           DateTime?
  completedAt         DateTime?
  createdAt           DateTime             @default(now())
  permissionSnapshots PermissionSnapshot[]

  @@index([shopId, createdAt])
}
