// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Shopify session storage — keep exactly as-is; used by
// @shopify/shopify-app-session-storage-prisma
// ---------------------------------------------------------------------------
model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// ---------------------------------------------------------------------------
// Ghost Code domain models
// ---------------------------------------------------------------------------

model Shop {
  id                    String               @id @default(cuid())
  domain                String               @unique
  installedAt           DateTime             @default(now())
  plan                  String               @default("free")
  lastThemePublishAt    DateTime?
  hasSeenReviewPrompt   Boolean              @default(false)
  scans                 Scan[]
  billingEvents         BillingEvent[]
}

model BillingEvent {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  eventType String   // "upgrade" | "downgrade" | "cancellation" | "reactivation"
  fromPlan  String?  // null for first subscription
  toPlan    String?  // null for cancellation
  amount    Float?   // monthly price of toPlan, null for cancellation
  createdAt DateTime @default(now())

  @@index([shopId])
  @@index([createdAt])
  @@index([eventType])
}

model Scan {
  id             String          @id @default(cuid())
  shopId         String
  shop           Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  themeId        String
  themeName      String
  status         ScanStatus      @default(PENDING)
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime        @default(now())
  findingCount   Int             @default(0)
  // FindingType categories whose OPTIONAL audit was skipped this run because the
  // required Shopify scope was not granted (ACCESS_DENIED). Drives PARTIAL status
  // and prevents the diff engine from falsely marking un-audited categories as
  // "resolved" (LOG-4). Empty for fully-audited scans and all legacy scans.
  skippedCategories String[]     @default([])
  findings       Finding[]
  unknownScripts UnknownScript[]

  @@index([shopId, createdAt])
}

// ---------------------------------------------------------------------------
// Unknown script collection + merchant feedback for signature expansion
// ---------------------------------------------------------------------------

model UnknownScript {
  id           String                @id @default(cuid())
  scanId       String
  scan         Scan                  @relation(fields: [scanId], references: [id], onDelete: Cascade)
  filename     String
  lineNumber   Int
  url          String
  resourceType String
  codeSnippet  String
  createdAt    DateTime              @default(now())
  submissions  SignatureSubmission[]

  @@index([scanId])
}

model SignatureSubmission {
  id               String           @id @default(cuid())
  unknownScriptId  String
  unknownScript    UnknownScript    @relation(fields: [unknownScriptId], references: [id], onDelete: Cascade)
  shopId           String
  suggestedAppName String
  status           SubmissionStatus @default(PENDING)
  reviewedAt       DateTime?
  createdAt        DateTime         @default(now())

  @@index([unknownScriptId])
  @@index([status])
}

model Finding {
  id          String      @id @default(cuid())
  scanId      String
  scan        Scan        @relation(fields: [scanId], references: [id], onDelete: Cascade)
  filename    String
  lineNumber  Int
  codeSnippet String
  findingType FindingType
  severity    Severity
  appName     String?
  description String
  createdAt   DateTime    @default(now())

  @@index([scanId])
  @@index([severity])
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum ScanStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  // The core theme scan succeeded and the scan is usable, but one or more
  // OPTIONAL audit categories were skipped because their Shopify scope was not
  // granted (ACCESS_DENIED) — i.e. not a full audit. Treated as a successful,
  // usable terminal status everywhere COMPLETED is (quota, dashboard, diffing).
  PARTIAL
  FAILED
}

enum FindingType {
  GHOST_SCRIPT
  GHOST_STYLE
  GHOST_SNIPPET
  GHOST_SECTION
  GHOST_HREFLANG
  ORPHAN_ASSET
  DUPLICATE_META
  GHOST_JSON_LD
  GHOST_TEXT
  GHOST_TRANSLATION
  SETTINGS_DRIFT
  GHOST_PIXEL
  JSON_LD_CONFLICT
  GHOST_LAYOUT
  GHOST_TAG
  GHOST_PRICE
  GHOST_PAGE
  GHOST_METAFIELD
  GHOST_REDIRECT
  GHOST_ROBOTS
  GHOST_CANONICAL
  GHOST_TITLE
  GHOST_OG
  GHOST_PRECONNECT
  GHOST_FONT
  GHOST_AJAX
}

enum SubmissionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum Severity {
  HIGH
  MEDIUM
  LOW
}

// ---------------------------------------------------------------------------
// Admin metrics snapshots — one per day, computed by daily cron
// ---------------------------------------------------------------------------

model MetricSnapshot {
  id                 String   @id @default(cuid())
  snapshotDate       DateTime @unique // one per day
  totalShops         Int
  activeShops        Int // shops with a scan in last 30 days
  shopsByPlan        Json // { free: N, professional: N, business: N }
  totalScans         Int // all-time
  scansLast7d        Int
  scansLast30d       Int
  completionRate     Float // completed / (completed + failed) last 30d
  totalFindings      Int // all-time
  avgFindingsPerScan Float
  createdAt          DateTime @default(now())
}

