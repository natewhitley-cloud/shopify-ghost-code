# Shopify
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=read_themes

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ghost_code

# Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Security — 64 hex characters (32 bytes) for AES-256-GCM token encryption
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# App
NODE_ENV=development
SHOPIFY_BILLING_TEST=true
