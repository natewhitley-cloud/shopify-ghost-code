# Shopify
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=read_themes

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ghost_code

# Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# App
NODE_ENV=development
SHOPIFY_BILLING_TEST=true

# Error tracking — optional. Leave empty to disable Sentry (app works normally without it).
# Get your DSN from https://sentry.io → Project Settings → Client Keys (DSN).
SENTRY_DSN=

# Ops alerts — operator email for failing Inngest crons and other observability breaches.
# Inert by default: unset OPS_ALERT_EMAIL means no email is ever sent (structured logs are
# always emitted). Set both OPS_ALERT_EMAIL and RESEND_API_KEY in Railway to enable delivery.
#   OPS_ALERT_EMAIL — recipient inbox and master switch (unset = feature off)
#   RESEND_API_KEY  — Resend API key (transport). Get one at https://resend.com
#   OPS_ALERT_FROM  — optional sender override (default: GhostCode Ops <onboarding@resend.dev>)
OPS_ALERT_EMAIL=
RESEND_API_KEY=
# OPS_ALERT_FROM=
