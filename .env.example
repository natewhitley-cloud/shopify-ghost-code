# Shopify
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=read_themes

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ghost_code

# Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# App
NODE_ENV=development
SHOPIFY_BILLING_TEST=true
# Public HTTPS base URL of the app. Required — shopify.server.ts throws at boot if unset.
# `shopify app dev` injects this automatically in local dev.
SHOPIFY_APP_URL=https://your-app.example.com

# Ops alerts — operator email for failing Inngest crons and other observability breaches.
# Inert by default: unset OPS_ALERT_EMAIL means no email is ever sent (structured logs are
# always emitted). Set both OPS_ALERT_EMAIL and RESEND_API_KEY in Railway to enable delivery.
#   OPS_ALERT_EMAIL — recipient inbox and master switch (unset = feature off)
#   RESEND_API_KEY  — Resend API key (transport). Get one at https://resend.com
#   OPS_ALERT_FROM  — optional sender override (default: GhostCode Ops <onboarding@resend.dev>)
OPS_ALERT_EMAIL=
RESEND_API_KEY=
# OPS_ALERT_FROM=

# Merchant summary emails (gc-ol95): one summary per store after each scheduled scan.
# DARK unless BOTH of these are set (plus RESEND_API_KEY above). Never falls back to
# the ops sender. Leave unset until the sending domain is verified (gc-syz.8).
#   MERCHANT_ALERTS_ENABLED: master switch; only the exact string "true" enables
#   MERCHANT_ALERT_FROM    : verified merchant-facing sender, e.g. "Ghost Code <...>"
MERCHANT_ALERTS_ENABLED=
MERCHANT_ALERT_FROM=

# Feature flags
# ENABLE_TREND_CHART: gates the dashboard Health Score / Findings Trend chart.
# Off unless set to the exact string "true". The chart is also plan-gated
# (Standard/Professional only), so enabling it here does nothing on Free.
# Set ENABLE_TREND_CHART=true in the Railway production service env to enable.
ENABLE_TREND_CHART=
